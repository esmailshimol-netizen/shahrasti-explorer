
<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#075b48">
<title>Chandpur Explorer | চাঁদপুর ভ্রমণ মানচিত্র</title>

<link rel="stylesheet"
 href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
*{box-sizing:border-box}
body{
 margin:0;padding:14px;background:#e9eee9;color:#19382f;
 font-family:system-ui,"Noto Sans Bengali",sans-serif
}
.card{
 max-width:650px;margin:auto;background:#fffdf7;padding:16px;
 border-radius:22px;border:1px solid #d8e1d5;
 box-shadow:0 12px 35px #173d3017
}
header{
 display:flex;align-items:center;justify-content:space-between;
 gap:10px;border-bottom:2px solid #e3e9dc;padding-bottom:13px
}
.profile{display:flex;align-items:center;gap:10px;min-width:0}
.avatar{
 width:56px;height:56px;flex-shrink:0;border-radius:50%;
 object-fit:cover;border:3px solid #08765b;background:#eee
}
.subtitle{font-size:11px;color:#65766c;margin:0}
h1{font-size:19px;margin:3px 0;color:#075b48}
.score{
 background:#075b48;color:white;border-radius:13px;padding:9px 12px;
 font-weight:800;font-size:20px;white-space:nowrap
}
.controls{
 margin:12px 0;display:grid;gap:8px
}
input[type=text],input[type=file],input[type=search]{
 width:100%;min-width:0;padding:10px;border:1px solid #d2ddd4;
 border-radius:9px;background:white;font:inherit;font-size:14px
}
.section-title{font-weight:800;font-size:15px;margin:16px 0 8px}
.intro{font-size:13px;color:#607269;line-height:1.7}
.map-wrap{
 overflow:hidden;border-radius:15px;border:1px solid #ccdacf;
 background:#e4efdf
}
#map{height:390px;width:100%;background:#e6efdf}
.map-note{font-size:11px;color:#63766b;padding:7px 9px}
.legend{
 display:flex;flex-wrap:wrap;gap:10px;font-size:11px;
 padding:8px 2px;color:#435b50
}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;
 margin-right:4px;background:#08765b}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.item{
 display:flex;gap:7px;align-items:flex-start;padding:9px;
 background:white;border:1px solid #e0e6dd;border-radius:9px;
 font-size:13px;line-height:1.5
}
.item input{margin-top:4px;accent-color:#08765b}
.item label{cursor:pointer;flex:1}
.progress{
 margin-top:14px;padding:12px;background:#edf4eb;border-radius:12px
}
.progress-top{display:flex;justify-content:space-between;gap:8px;
 font-size:12px;font-weight:700}
.track{height:8px;background:#d5e1d4;border-radius:20px;
 margin-top:9px;overflow:hidden}
#bar{height:100%;width:0;background:#08765b;transition:width .2s}
button{
 border:0;border-radius:10px;padding:12px 14px;font:inherit;
 font-size:13px;font-weight:750;cursor:pointer
}
.primary{background:#075b48;color:white;width:100%;margin-top:12px}
.secondary{background:#e8f1e8;color:#075b48}
.actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
footer{text-align:center;font-size:11px;color:#718077;margin-top:14px}
.place-name{font-weight:800;font-size:14px}
.place-desc{font-size:12px;line-height:1.6}
.leaflet-popup-content{min-width:160px}
@media(max-width:420px){
 body{padding:7px}.card{padding:11px;border-radius:16px}
 h1{font-size:16px}.avatar{width:47px;height:47px}
 #map{height:340px}.grid{grid-template-columns:1fr}
}
@media print{
 body{padding:0;background:white}.card{box-shadow:none}
 .no-capture{display:none!important}
}
</style>
</head>

<body>
<main class="card" id="captureCard">

<header>
 <div class="profile">
  <img id="avatar" class="avatar"
   alt="প্রোফাইল ছবি"
   src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 60 60'%3E%3Crect width='60' height='60' rx='30' fill='%23dce9df'/%3E%3Ccircle cx='30' cy='22' r='11' fill='%23075b48'/%3E%3Cpath d='M9 57 Q10 35 30 35 Q50 35 51 57' fill='%23075b48'/%3E%3C/svg%3E">
  <div>
   <p class="subtitle">BANGLADESH · CHANDPUR</p>
   <h1 id="userNameDisplay">ইসমাইল হোসেন</h1>
   <div class="subtitle">আমার জেলার ভ্রমণ ডায়েরি</div>
  </div>
 </div>
 <div class="score" id="score">০/৮</div>
</header>

<div class="controls no-capture">
 <input id="userName" type="text" value="ইসমাইল হোসেন"
  placeholder="আপনার নাম" aria-label="আপনার নাম">
 <input id="imageInput" type="file" accept="image/*"
  aria-label="প্রোফাইল ছবি নির্বাচন">
</div>

<div class="section-title">🌍 চাঁদপুর জেলার জীবন্ত মানচিত্র</div>
<p class="intro">
 নদী, খাল, রাস্তা, বসতি ও স্থানগুলোর তথ্য দেখতে মানচিত্রে জুম করুন।
 কোনো মার্কারে চাপ দিলে দর্শনীয় স্থানের তথ্য দেখাবে।
</p>

<div class="map-wrap">
 <div id="map" aria-label="চাঁদপুর জেলার মানচিত্র"></div>
 <div class="map-note">
  মানচিত্রের তথ্য © OpenStreetMap contributors · ইন্টারনেট প্রয়োজন
 </div>
</div>

<div class="legend">
 <span><i class="dot"></i>দর্শনীয় স্থান</span>
 <span>🔵 নদী ও জলপথ</span>
 <span>🛣️ রাস্তা</span>
</div>

<div class="section-title">📍 দর্শনীয় স্থান ঘুরে দেখুন</div>
<div id="places" class="grid"></div>

<div class="section-title">🗺️ কোন কোন উপজেলা ঘুরেছেন?</div>
<div id="upazilas" class="grid"></div>

<div class="progress">
 <div class="progress-top">
  <span>আপনার ভ্রমণ অগ্রগতি</span>
  <span id="percent">০%</span>
 </div>
 <div class="track"><div id="bar"></div></div>
 <p id="progressText" class="intro">এখনও কোনো উপজেলা নির্বাচন করা হয়নি।</p>
</div>

<div class="actions no-capture">
 <button class="secondary" onclick="resetProgress()">↻ আবার শুরু</button>
 <button class="secondary" onclick="zoomDistrict()">📍 জেলা দেখুন</button>
</div>
<button class="primary no-capture" onclick="downloadCard()">
 📸 ভ্রমণ কার্ড ডাউনলোড করুন
</button>

<footer>
 Chandpur Explorer · Explore Rivers, Culture & Heritage
</footer>
</main>

<script>
"use strict";

// চাঁদপুর শহরের কাছাকাছি প্রাথমিক ভিউ।
// স্থানাঙ্কগুলো আনুমানিক; ভ্রমণের আগে অবস্থান যাচাই করুন।
const center = [23.226, 90.655];

const map = L.map("map", {
  zoomControl: true,
  scrollWheelZoom: true
}).setView(center, 10);

L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
  maxZoom: 19,
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
}).addTo(map);

const upazilaData = [
 ["sadar","চাঁদপুর সদর"],
 ["hajiganj","হাজীগঞ্জ"],
 ["shahrasti","শাহরাস্তি"],
 ["matlab-n","মতলব উত্তর"],
 ["matlab-s","মতলব দক্ষিণ"],
 ["kachua","কচুয়া"],
 ["faridganj","ফরিদগঞ্জ"],
 ["haimchar","হাইমচর"]
];

// নাম, আনুমানিক স্থানাঙ্ক ও পরিচিতির সংক্ষিপ্ত বিবরণ
const placeData = [
 {
  id:"molhead", name:"মোলহেড — ত্রিনদীর সঙ্গমস্থল",
  pos:[23.228,90.649],
  desc:"পদ্মা, মেঘনা ও ডাকাতিয়ার সঙ্গম এলাকার বিখ্যাত নদীতীর।"
 },
 {
  id:"ilish", name:"ইলিশ চত্বর",
  pos:[23.230,90.650],
  desc:"চাঁদপুর শহরের ইলিশ ঐতিহ্যের পরিচিত ভাস্কর্য।"
 },
 {
  id:"angikar", name:"অঙ্গীকার ভাস্কর্য",
  pos:[23.232,90.650],
  desc:"চাঁদপুরের মুক্তিযুদ্ধের স্মৃতিবাহী পরিচিত স্থাপনা।"
 },
 {
  id:"hajiganj-mosque", name:"হাজীগঞ্জ বড় মসজিদ",
  pos:[23.252,90.858],
  desc:"হাজীগঞ্জের পরিচিত ধর্মীয় ও ঐতিহাসিক স্থাপনা।"
 },
 {
  id:"rupsha", name:"রূপসা জমিদার বাড়ি",
  pos:[23.080,90.770],
  desc:"ফরিদগঞ্জ এলাকার ঐতিহাসিক জমিদারবাড়ি হিসেবে পরিচিত।"
 },
 {
  id:"lohagara", name:"লোহাগড় মঠ",
  pos:[23.380,90.840],
  desc:"চাঁদপুর অঞ্চলের ঐতিহাসিক স্থাপনার একটি।"
 }
];

const touristLayer = L.layerGroup().addTo(map);
const touristMarkers = {};

placeData.forEach(place => {
 const marker = L.marker(place.pos);
 marker.bindPopup(
  '<div class="place-name">' + place.name + '</div>' +
  '<p class="place-desc">' + place.desc + '</p>' +
  '<a target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(place.name + ", Chandpur, Bangladesh") +
  '">Google Maps-এ অবস্থান দেখুন ↗</a>'
 );
 marker.addTo(touristLayer);
 touristMarkers[place.id] = marker;
});

function makeChecklist(containerId, data, prefix, onToggle) {
 const container = document.getElementById(containerId);
 data.forEach((entry, index) => {
  const id = prefix + "-" + entry.id;
  const row = document.createElement("div");
  row.className = "item";

  const checkbox = document.createElement("input");
  checkbox.type = "checkbox";
  checkbox.id = id;
  checkbox.addEventListener("change", onToggle);

  const label = document.createElement("label");
  label.htmlFor = id;
  label.textContent = (index + 1) + ". " + entry.name;

  row.append(checkbox, label);
  container.appendChild(row);
 });
}

makeChecklist("places", placeData, "place", updateProgress);
makeChecklist("upazilas", upazilaData, "upa", updateProgress);

function bengaliNumber(number) {
 return String(number).replace(/\d/g, d => "০১২৩৪৫৬৭৮৯"[Number(d)]);
}

function updateProgress() {
 const selected = document.querySelectorAll("#upazilas input:checked").length;
 const percent = Math.round(selected / upazilaData.length * 100);

 document.getElementById("score").textContent =
  bengaliNumber(selected) + "/" + bengaliNumber(upazilaData.length);
 document.getElementById("percent").textContent =
  bengaliNumber(percent) + "%";
 document.getElementById("bar").style.width = percent + "%";
 document.getElementById("progressText").textContent =
  selected === 0 ? "এখনও কোনো উপজেলা নির্বাচন করা হয়নি।" :
  "আপনি " + bengaliNumber(selected) + "টি উপজেলা নির্বাচন করেছেন।";

 const name = document.getElementById("userName").value.trim();
 document.getElementById("userNameDisplay").textContent = name || "ভ্রমণকারী";
}

document.getElementById("userName").addEventListener("input", updateProgress);

document.getElementById("imageInput").addEventListener("change", event => {
 const file = event.target.files && event.target.files[0];
 if (!file) return;
 if (!file.type.startsWith("image/")) {
  alert("অনুগ্রহ করে একটি ছবি নির্বাচন করুন।");
  return;
 }
 const reader = new FileReader();
 reader.onload = () => {
  document.getElementById("avatar").src = reader.result;
 };
 reader.readAsDataURL(file);
});

function zoomDistrict() {
 map.setView(center, 10);
}

function resetProgress() {
 document.querySelectorAll("#upazilas input, #places input")
  .forEach(input => input.checked = false);
 updateProgress();
}

async function downloadCard() {
 const button = document.querySelector(".primary");
 button.disabled = true;
 button.textContent = "ছবি তৈরি হচ্ছে...";

 try {
  // Leaflet-এর বাইরের মানচিত্র টাইল canvas-এ রপ্তানি
  // সব ব্রাউজার/টাইল সার্ভারে সমর্থিত নাও হতে পারে।
  const canvas = await html2canvas(
   document.getElementById("captureCard"),
   {scale:2, useCORS:true, backgroundColor:"#fffdf7", logging:false}
  );

  const link = document.createElement("a");
  link.download = "chandpur-explorer.png";
  link.href = canvas.toDataURL("image/png");
  link.click();
 } catch (error) {
  alert("কার্ড তৈরি করা যায়নি। মানচিত্রের টাইল রপ্তানি সীমাবদ্ধ হতে পারে। স্ক্রিনশট নিন অথবা মানচিত্রের বাইরের কার্ড ডাউনলোড চেষ্টা করুন।");
 } finally {
  button.disabled = false;
  button.textContent = "📸 ভ্রমণ কার্ড ডাউনলোড করুন";
 }
}

updateProgress();

// Leaflet কখনও কখনও মোবাইলের প্রথম লোডে
// মানচিত্রের আকার পুনর্নির্ণয় করতে হয়।
setTimeout(() => map.invalidateSize(), 300);
</script>
</body>
</html>
